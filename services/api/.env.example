# Used when running the API directly on the host.
DATABASE_URL=postgresql+psycopg://topicpilot:topicpilot_local_only@localhost:5432/topicpilot
# Optional separate Alembic endpoint. Use a direct Neon connection for DDL;
# when omitted, Alembic falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=

# Used by the local PostgreSQL Compose service.
POSTGRES_DB=topicpilot
POSTGRES_USER=topicpilot
POSTGRES_PASSWORD=topicpilot_local_only
POSTGRES_PORT=5432

TOPICPILOT_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
TOPICPILOT_FRESHNESS_DAYS=3
TOPICPILOT_LOG_LEVEL=INFO

# V2 official daily backfill / post-close runtime.
TOPICPILOT_HISTORY_BATCH_SIZE=20
TOPICPILOT_HISTORY_REQUESTS_PER_MINUTE=30
TOPICPILOT_HISTORY_MIN_REQUEST_INTERVAL_SECONDS=0.5
TOPICPILOT_HISTORY_MAX_RETRIES=4
TOPICPILOT_HISTORY_RETRY_BACKOFF_SECONDS=2.0
