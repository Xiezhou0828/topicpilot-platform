# Local-only defaults. Copy to .env and change values only when needed.
# Never commit .env or production credentials.
POSTGRES_DB=topicpilot
POSTGRES_USER=topicpilot
POSTGRES_PASSWORD=topicpilot_local_only
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://topicpilot:topicpilot_local_only@postgres:5432/topicpilot
TOPICPILOT_LOG_LEVEL=INFO
TOPICPILOT_DEMO_MODE=true
TOPICPILOT_BUNDLE_PATH=/fixtures/demo
TOPICPILOT_FRESHNESS_DAYS=3
API_PORT=8000
WEB_PORT=3000

# Browser-visible API origin used while building the web container.
PUBLIC_API_BASE_URL=http://localhost:8000

# Comma-separated origins. Keep production origins explicit.
TOPICPILOT_CORS_ORIGINS=http://localhost:3000

# Override only if the API package uses a different ASGI import path.
UVICORN_APP=topicpilot_api.main:app
OPENAPI_APP=topicpilot_api.main:app
