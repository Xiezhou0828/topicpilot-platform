{
  "name": "@topicpilot/api-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/client.d.mts",
      "import": "./src/client.mjs"
    },
    "./schema": "./src/schema.d.ts"
  },
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/schema.d.ts && node scripts/sync-to-web.mjs",
    "check": "npm run generate && git diff --exit-code -- openapi.json src/schema.d.ts ../../apps/web/app/lib/generated-api.d.ts",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "openapi-typescript": "7.13.0"
  },
  "overrides": {
    "brace-expansion": "5.0.9"
  }
}
